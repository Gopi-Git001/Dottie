{
  "name": "@dottie/desktop",
  "productName": "Dottie",
  "version": "0.1.0",
  "private": true,
  "description": "Dottie Windows tray shell (Electron main, preload, renderer)",
  "author": "Dottie team",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:packaging": "node scripts/check-packaging.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "npm run build:fast && electron .",
    "package:win": "npm run build:prod && electron-builder --win --config electron-builder.yml",
    "package:win:msix": "npm run build:prod && electron-builder --win appx --config electron-builder.yml",
    "package:win:nsis": "npm run build:prod && electron-builder --win nsis --config electron-builder.yml",
    "package:dir": "npm run build:prod && electron-builder --dir --config electron-builder.yml",
    "build:prod": "npm run typecheck && node scripts/build.mjs --production",
    "smoke": "npm run build:fast && electron . --dottie-smoke-test --dottie-smoke-ui",
    "smoke:ci": "npm run build:fast && node scripts/smoke-run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
